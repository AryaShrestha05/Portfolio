# Visitor counter — disable the bottom-left widget entirely
# VITE_DISABLE_VISITOR_COUNTER=true

# Optional: full URL to your counter API (e.g. static site calling a separate Vercel function)
# Must return JSON like { "value": 123 } after POST (or GET for a read-only endpoint you control).
# VITE_VISITOR_API_URL=https://your-project.vercel.app/api/visits

# Vercel + Upstash Redis — add these in Vercel → Project → Settings → Environment Variables
# (Create a free database: https://console.upstash.com → Redis → REST API → copy URL + token)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
